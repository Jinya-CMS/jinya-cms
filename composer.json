{
  "name": "jinya/cms",
  "version": "26.2.3",
  "homepage": "https://jinya.de",
  "license": "MIT",
  "require": {
    "php": ">=8.4",
    "ext-date": "*",
    "ext-fileinfo": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-zip": "*",
    "ext-zlib": "*",
    "asika/agent": "2.7.3",
    "bacon/bacon-qr-code": "v3.1.1",
    "guzzlehttp/guzzle": "7.10.1",
    "intervention/image": "v4.1.0",
    "jcupitt/vips": "v2.6.1",
    "jetbrains/phpstorm-attributes": "1.2",
    "jinya/configuration": "0.10.0",
    "jinya/database": "0.18.0",
    "jinya/plates": "5.0.2",
    "jinya/router": "0.11.0",
    "jinya/router-extensions": "0.21.0",
    "laminas/laminas-hydrator": "4.19.0",
    "league/climate": "3.10.1",
    "league/uri": "7.8.1",
    "matomo/device-detector": "6.5.0",
    "melbahja/semver": "v1.0.1",
    "monolog/monolog": "3.10.0",
    "nyholm/psr7": "1.8.2",
    "nyholm/psr7-server": "1.1.0",
    "phpmailer/phpmailer": "v7.1.1",
    "phpmyadmin/sql-parser": "6.0.0",
    "scssphp/scssphp": "v2.1.0",
    "spomky-labs/otphp": "v11.4.2",
    "symfony/filesystem": "v8.0.11",
    "tedivm/jshrink": "v1.8.1",
    "vlucas/phpdotenv": "v5.6.3"
  },
  "suggest": {
    "ext-zend-opcache": "*",
    "ext-apcu": "*",
    "ext-frankenphp": "*",
    "ext-ffi": "*",
    "ext-gd": "*",
    "ext-imagick": "*"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "fakerphp/faker": "v1.24.1",
    "laravel/pint": "v1.29.1"
  },
  "config": {
    "process-timeout": 0,
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Jinya\\Cms\\": "src/",
      "Jinya\\Cms\\Migrations\\": "migrations/"
    },
    "files": [
      "src/images.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Jinya\\Cms\\": "tests/"
    }
  },
  "description": "Jinya CMS is a modern content management system targeted at artists"
}
